# Copie para lab.env e ajuste. Linhas começando com # são comentários.
NS=default
UE_POD=deployment/ueransim-gnb-ues
UE_IF=uesimtun0
SERVER_POD=iperf-server
UPF_REGEX=upf
UPF_IFACE=ogstun
# UPF_NS só é necessário se a UPF estiver em outro namespace (por padrão usa NS).
# Opcionais: padrões de nome dos pods cuja CPU é amostrada (UE e gNB).
UE_REGEX=^ueransim-gnb-ues-
GNB_REGEX=^ueransim-gnb-(?!ues)
# Opcional: 2º UE (outra sessão PDU) usado como "sonda" de baixa taxa
PROBE_IF=uesimtun1
PROBE_MBPS=2
